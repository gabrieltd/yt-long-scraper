# Copy this file to .env and choose a unique, long password.
POSTGRES_USER=yt_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=yt_discovery

# 0.0.0.0 is required only when GitHub Actions connects through Tailscale.
# Protect it with the Windows Firewall and Tailscale ACL described in README.md.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
